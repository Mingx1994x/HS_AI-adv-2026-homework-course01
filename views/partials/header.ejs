<header class="sticky top-0 z-50 bg-bh-black">
  <div class="max-w-7xl mx-auto flex items-center justify-between px-8 h-[72px]">
    <a href="/" class="flex items-center gap-2.5 text-xl font-black text-bh-white font-display">
      <%- include('./stem-bud') %>
      花漾生活
    </a>

    <nav class="flex items-center gap-8 text-xs font-bold tracking-widest uppercase text-bh-white">
      <a href="/" class="hover:text-bh-yellow transition-colors">商品列表</a>
      <a href="/cart" class="hover:text-bh-yellow transition-colors flex items-center gap-1.5">
        購物車
        <span
          id="cart-badge"
          class="bg-bh-yellow text-bh-black text-xs font-bold w-5 h-5 items-center justify-center"
          style="display: none;"
        ></span>
      </a>
      <a id="orders-link" href="/orders" class="hover:text-bh-yellow transition-colors" style="display: none;">
        我的訂單
      </a>
    </nav>

    <div id="auth-nav" class="flex items-center gap-4 text-xs font-bold tracking-widest uppercase">
      <a href="/login" class="bg-bh-red text-bh-white px-5 py-1.5 hover:bg-bh-white hover:text-bh-black transition-colors">登入</a>
    </div>
  </div>
</header>
