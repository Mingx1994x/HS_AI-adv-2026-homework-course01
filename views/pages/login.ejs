<div id="app" class="bg-bh-white text-bh-black">
  <div class="overflow-hidden">
    <div class="min-h-[60vh] flex items-center justify-center py-8">
      <div class="relative z-0 bg-bh-white border-2 border-bh-black w-full max-w-md p-8">
        <div v-show="activeTab === 'register'" class="absolute -bottom-32 -right-32 md:-bottom-[240px] md:-right-[240px] w-64 h-64 md:w-[480px] md:h-[480px] rounded-full bg-bh-red -z-10"></div>
        <div v-show="activeTab === 'login'" class="absolute -left-24 top-24 md:-left-40 w-56 h-48 md:w-72 md:h-64 bg-bh-yellow rotate-[15deg] [clip-path:polygon(0%_0%,100%_0%,50%_100%)] -z-10"></div>

        <div class="relative z-10">
          <h1 class="text-2xl font-black font-display text-center mb-6">
            花漾生活
          </h1>

          <!-- Tabs -->
          <div class="flex mb-6 border-2 border-bh-black h-12">
            <button
              @click="activeTab = 'login'; errors = {}"
              class="flex-1 text-sm font-bold transition-colors"
              :class="activeTab === 'login' ? 'bg-bh-black text-bh-white' : 'bg-bh-white text-bh-black hover:bg-bh-black/5'"
            >
              登入
            </button>
            <button
              @click="activeTab = 'register'; errors = {}"
              class="flex-1 text-sm font-bold border-l-2 border-bh-black transition-colors"
              :class="activeTab === 'register' ? 'bg-bh-black text-bh-white' : 'bg-bh-white text-bh-black hover:bg-bh-black/5'"
            >
              註冊
            </button>
          </div>

          <!-- Login Form -->
          <form v-if="activeTab === 'login'" @submit.prevent="handleLogin" class="space-y-5">
            <div>
              <label class="block text-xs font-bold tracking-widest uppercase mb-2">Email</label>
              <input
                v-model="loginForm.email"
                type="email"
                placeholder="請輸入 Email"
                class="w-full border-2 border-bh-black px-4 py-3 text-sm placeholder:text-bh-black/40 focus:outline-none focus:border-bh-blue transition-colors"
                :class="{ 'border-bh-red': errors.email }"
              />
              <p v-if="errors.email" class="text-bh-red text-xs mt-1">{{ errors.email }}</p>
            </div>

            <div>
              <label class="block text-xs font-bold tracking-widest uppercase mb-2">密碼</label>
              <input
                v-model="loginForm.password"
                type="password"
                placeholder="請輸入密碼"
                class="w-full border-2 border-bh-black px-4 py-3 text-sm placeholder:text-bh-black/40 focus:outline-none focus:border-bh-blue transition-colors"
                :class="{ 'border-bh-red': errors.password }"
              />
              <p v-if="errors.password" class="text-bh-red text-xs mt-1">{{ errors.password }}</p>
            </div>

            <button
              type="submit"
              :disabled="submitting"
              class="w-full bg-bh-blue text-bh-white py-3 text-xs font-bold tracking-widest uppercase hover:bg-bh-black transition-colors disabled:opacity-50"
            >
              {{ submitting ? '登入中...' : '登入' }}
            </button>
          </form>

          <!-- Register Form -->
          <form v-else @submit.prevent="handleRegister" class="space-y-5">
            <div>
              <label class="block text-xs font-bold tracking-widest uppercase mb-2">姓名</label>
              <input
                v-model="registerForm.name"
                type="text"
                placeholder="請輸入姓名"
                class="w-full border-2 border-bh-black px-4 py-3 text-sm placeholder:text-bh-black/40 focus:outline-none focus:border-bh-blue transition-colors"
                :class="{ 'border-bh-red': errors.name }"
              />
              <p v-if="errors.name" class="text-bh-red text-xs mt-1">{{ errors.name }}</p>
            </div>

            <div>
              <label class="block text-xs font-bold tracking-widest uppercase mb-2">Email</label>
              <input
                v-model="registerForm.email"
                type="email"
                placeholder="請輸入 Email"
                class="w-full border-2 border-bh-black px-4 py-3 text-sm placeholder:text-bh-black/40 focus:outline-none focus:border-bh-blue transition-colors"
                :class="{ 'border-bh-red': errors.email }"
              />
              <p v-if="errors.email" class="text-bh-red text-xs mt-1">{{ errors.email }}</p>
            </div>

            <div>
              <label class="block text-xs font-bold tracking-widest uppercase mb-2">密碼</label>
              <input
                v-model="registerForm.password"
                type="password"
                placeholder="至少 6 個字元"
                class="w-full border-2 border-bh-black px-4 py-3 text-sm placeholder:text-bh-black/40 focus:outline-none focus:border-bh-blue transition-colors"
                :class="{ 'border-bh-red': errors.password }"
              />
              <p v-if="errors.password" class="text-bh-red text-xs mt-1">{{ errors.password }}</p>
            </div>

            <button
              type="submit"
              :disabled="submitting"
              class="w-full bg-bh-blue text-bh-white py-3 text-xs font-bold tracking-widest uppercase hover:bg-bh-black transition-colors disabled:opacity-50"
            >
              {{ submitting ? '註冊中...' : '註冊' }}
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
