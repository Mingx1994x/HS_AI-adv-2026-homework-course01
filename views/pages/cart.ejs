<div id="app" class="bg-bh-white text-bh-black">
  <h1 class="text-3xl font-black font-display leading-[0.95] mb-6">購物車</h1>

  <div v-if="loading" class="flex justify-center py-12">
    <div class="w-8 h-8 border-4 border-bh-red border-t-transparent rounded-full animate-spin"></div>
  </div>

  <div v-else-if="items.length === 0" class="text-center py-12">
    <div class="w-16 h-16 mx-auto mb-4 rounded-full border-2 border-bh-black"></div>
    <p class="text-bh-black mb-1">購物車是空的</p>
    <p class="text-bh-black/60 text-sm mb-4">快去挑選喜歡的花束吧！</p>
    <a href="/" class="inline-block bg-bh-red text-bh-white px-6 py-2 text-xs font-bold tracking-widest uppercase hover:bg-bh-black transition-colors">去逛逛</a>
  </div>

  <template v-else>
    <!-- Free shipping banner -->
    <div v-if="total < freeShippingThreshold" class="bg-bh-yellow p-3 mb-6 text-xs font-bold tracking-widest uppercase text-center text-bh-black">
      再買 NT$ {{ (freeShippingThreshold - total).toLocaleString() }} 即可享免基本運費
    </div>
    <div v-else class="bg-bh-blue p-3 mb-6 text-xs font-bold tracking-widest uppercase text-center text-bh-white">
      已達免運門檻！
    </div>

    <div class="flex flex-col lg:flex-row gap-12">
      <!-- Cart Items -->
      <div class="flex-1">
        <div
          v-for="item in items"
          :key="item.id"
          class="flex items-center gap-4 py-5 border-b border-bh-black"
        >
          <img
            :src="item.product.image_url || 'https://images.unsplash.com/photo-1490750967868-88aa4f44baee?w=100'"
            :alt="item.product.name"
            class="w-20 h-20 object-cover flex-shrink-0"
          />
          <div class="flex-1 min-w-0">
            <h3 class="font-bold text-sm truncate mb-1">{{ item.product.name }}</h3>
            <p class="font-numeral font-bold text-sm">NT$ {{ item.product.price.toLocaleString() }}</p>
          </div>

          <!-- Quantity Controls -->
          <div class="flex items-center border-2 border-bh-black">
            <button
              @click="updateQuantity(item.id, item.quantity - 1)"
              :disabled="item.quantity <= 1"
              class="w-8 h-9 flex items-center justify-center hover:bg-bh-black hover:text-bh-white font-numeral font-bold disabled:opacity-40"
            >
              −
            </button>
            <span class="w-8 h-9 flex items-center justify-center text-sm font-numeral font-bold border-x-2 border-bh-black">
              {{ item.quantity }}
            </span>
            <button
              @click="updateQuantity(item.id, item.quantity + 1)"
              :disabled="item.quantity >= item.product.stock"
              class="w-8 h-9 flex items-center justify-center hover:bg-bh-black hover:text-bh-white font-numeral font-bold disabled:opacity-40 disabled:cursor-not-allowed"
            >
              +
            </button>
          </div>

          <p class="font-numeral font-black text-bh-red text-sm w-24 text-right">
            NT$ {{ (item.product.price * item.quantity).toLocaleString() }}
          </p>

          <button
            @click="confirmDelete(item.id)"
            class="w-7 h-7 flex items-center justify-center border-2 border-bh-black hover:bg-bh-black hover:text-bh-white transition-colors text-xs"
          >
            ✕
          </button>
        </div>
      </div>

      <!-- Summary -->
      <div class="w-full lg:w-[360px] bg-bh-black text-bh-white p-8 flex flex-col gap-4 self-start">
        <span class="text-xs font-bold tracking-widest uppercase">訂單摘要</span>
        <div class="h-px bg-bh-white"></div>
        <div class="flex justify-between items-center text-sm">
          <span>商品小計</span>
          <span class="font-numeral">NT$ {{ total.toLocaleString() }}</span>
        </div>
        <div class="flex justify-between items-center text-sm">
          <span>運費</span>
          <span class="font-numeral">{{ shippingFee === 0 ? '免運' : ('NT$ ' + shippingFee.toLocaleString()) }}</span>
        </div>
        <div class="flex justify-between items-center pt-2">
          <span class="font-bold text-lg">總計</span>
          <span class="font-numeral font-black text-2xl text-bh-red">
            NT$ {{ grandTotal.toLocaleString() }}
          </span>
        </div>
        <p class="text-bh-white/60 text-xs">＊實際運費將依配送方式與收件地址於結帳頁計算，此為宅配基本運費估算值</p>
        <button
          @click="goCheckout"
          class="w-full mt-2 bg-bh-red text-bh-white py-3 text-xs font-bold tracking-widest uppercase hover:bg-bh-white hover:text-bh-black transition-colors"
        >
          前往結帳
        </button>
      </div>
    </div>
  </template>

  <!-- Confirm Dialog -->
  <div v-if="confirmVisible" class="fixed inset-0 z-50 flex items-center justify-center">
    <div class="absolute inset-0 bg-bh-black/60" @click="confirmVisible = false"></div>
    <div class="relative bg-bh-white border-2 border-bh-black w-full max-w-sm mx-4 p-6 text-center">
      <h3 class="text-lg font-bold mb-2">確認移除</h3>
      <p class="text-bh-black/70 text-sm mb-6">確定要從購物車中移除這個商品嗎？</p>
      <div class="flex gap-3 justify-center">
        <button @click="confirmVisible = false" class="px-4 py-2 text-sm border-2 border-bh-black hover:bg-bh-black hover:text-bh-white transition-colors">取消</button>
        <button @click="handleDelete" class="px-4 py-2 text-sm bg-bh-red text-bh-white hover:bg-bh-black transition-colors">確認移除</button>
      </div>
    </div>
  </div>
</div>
