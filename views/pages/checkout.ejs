<div id="app" class="bg-bh-white text-bh-black">
  <h1 class="text-3xl font-black font-display leading-[0.95] mb-6">結帳</h1>

  <div v-if="loading" class="flex justify-center py-12">
    <div class="w-8 h-8 border-4 border-bh-red border-t-transparent rounded-full animate-spin"></div>
  </div>

  <div v-else class="flex flex-col lg:flex-row gap-12">
    <!-- Left: Form -->
    <div class="flex-1">
      <h2 class="font-bold font-display text-lg mb-5">收件資訊</h2>
      <div class="space-y-5">
        <div>
          <label class="block text-xs font-bold tracking-widest uppercase mb-2">收件人姓名</label>
          <input
            v-model="form.recipientName"
            type="text"
            placeholder="請輸入收件人姓名"
            class="w-full border-2 border-bh-black px-4 py-3 text-sm placeholder:text-bh-black/40 focus:outline-none focus:border-bh-red transition-colors"
            :class="{ 'border-bh-red': errors.recipientName }"
          />
          <p v-if="errors.recipientName" class="text-bh-red text-xs mt-1">{{ errors.recipientName }}</p>
        </div>
        <div>
          <label class="block text-xs font-bold tracking-widest uppercase mb-2">Email</label>
          <input
            v-model="form.recipientEmail"
            type="email"
            placeholder="請輸入 Email"
            class="w-full border-2 border-bh-black px-4 py-3 text-sm placeholder:text-bh-black/40 focus:outline-none focus:border-bh-red transition-colors"
            :class="{ 'border-bh-red': errors.recipientEmail }"
          />
          <p v-if="errors.recipientEmail" class="text-bh-red text-xs mt-1">{{ errors.recipientEmail }}</p>
        </div>
        <div>
          <label class="block text-xs font-bold tracking-widest uppercase mb-2">收件地址</label>
          <input
            v-model="form.recipientAddress"
            type="text"
            placeholder="請輸入收件地址"
            class="w-full border-2 border-bh-black px-4 py-3 text-sm placeholder:text-bh-black/40 focus:outline-none focus:border-bh-red transition-colors"
            :class="{ 'border-bh-red': errors.recipientAddress }"
          />
          <p v-if="errors.recipientAddress" class="text-bh-red text-xs mt-1">{{ errors.recipientAddress }}</p>
          <p v-if="isRemoteArea" class="text-bh-red text-xs mt-1">系統偵測您的收件地址為偏遠地區，運費將加收 NT$ 200</p>
        </div>
        <div>
          <label class="block text-xs font-bold tracking-widest uppercase mb-2">配送方式</label>
          <div class="flex gap-3">
            <label
              class="flex-1 flex items-center justify-between border-2 px-4 py-3 text-sm cursor-pointer transition-colors"
              :class="form.shippingMethod === 'home' ? 'border-bh-red bg-bh-red/5' : 'border-bh-black'"
            >
              <span class="flex items-center gap-2">
                <input type="radio" value="home" v-model="form.shippingMethod" class="accent-bh-red" />
                宅配到府
              </span>
              <span class="font-numeral text-xs text-bh-black/60">NT$ 120</span>
            </label>
            <label
              class="flex-1 flex items-center justify-between border-2 px-4 py-3 text-sm cursor-pointer transition-colors"
              :class="form.shippingMethod === 'store' ? 'border-bh-red bg-bh-red/5' : 'border-bh-black'"
            >
              <span class="flex items-center gap-2">
                <input type="radio" value="store" v-model="form.shippingMethod" class="accent-bh-red" />
                超商取貨
              </span>
              <span class="font-numeral text-xs text-bh-black/60">NT$ 60</span>
            </label>
          </div>
        </div>
        <div>
          <label class="flex items-center gap-2 text-sm cursor-pointer">
            <input type="checkbox" v-model="form.isExpress" class="accent-bh-red w-4 h-4" />
            <span>急件加購（當日配送，加收 NT$ 250）</span>
          </label>
        </div>
      </div>
    </div>

    <!-- Right: Summary -->
    <div class="w-full lg:w-[400px]">
      <div class="bg-bh-blue text-bh-white p-8 flex flex-col gap-4 sticky top-24">
        <span class="text-xs font-bold tracking-widest uppercase">訂單摘要</span>
        <div class="space-y-3">
          <div v-for="item in cartItems" :key="item.id" class="flex justify-between items-center text-sm">
            <span>{{ item.product.name }} x {{ item.quantity }}</span>
            <span class="font-numeral font-bold">NT$ {{ (item.product.price * item.quantity).toLocaleString() }}</span>
          </div>
        </div>
        <div class="h-px bg-bh-white"></div>
        <div class="space-y-2 text-sm">
          <div class="flex justify-between">
            <span>商品小計</span>
            <span class="font-numeral">NT$ {{ cartTotal.toLocaleString() }}</span>
          </div>
          <div class="flex justify-between">
            <span>運費</span>
            <span class="font-numeral">{{ shippingFee === 0 ? '免運' : ('NT$ ' + shippingFee.toLocaleString()) }}</span>
          </div>
        </div>
        <div class="flex justify-between items-center pt-2">
          <span class="font-bold text-lg">總計</span>
          <span class="inline-block bg-bh-white text-bh-red font-numeral font-black text-xl px-3.5 py-1.5">
            NT$ {{ grandTotal.toLocaleString() }}
          </span>
        </div>
        <button
          @click="submitOrder"
          :disabled="submitting"
          class="w-full mt-2 bg-bh-yellow text-bh-black py-3 text-xs font-bold tracking-widest uppercase hover:bg-bh-black hover:text-bh-white transition-colors disabled:opacity-50"
        >
          {{ submitting ? '處理中...' : '確認送出訂單' }}
        </button>
      </div>
    </div>
  </div>
</div>
