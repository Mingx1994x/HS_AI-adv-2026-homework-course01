<div id="app" class="bg-bh-white text-bh-black">
  <h1 class="text-3xl font-black font-display leading-[0.95] mb-6">我的訂單</h1>

  <div v-if="loading" class="flex justify-center py-12">
    <div class="w-8 h-8 border-4 border-bh-red border-t-transparent rounded-full animate-spin"></div>
  </div>

  <div v-else-if="orders.length === 0" class="text-center py-12">
    <div class="w-16 h-16 mx-auto mb-4 rounded-full border-2 border-bh-black"></div>
    <p class="text-bh-black mb-1">尚無訂單</p>
    <p class="text-bh-black/60 text-sm mb-4">快去選購喜歡的花束吧！</p>
    <a href="/" class="inline-block bg-bh-red text-bh-white px-6 py-2 text-xs font-bold tracking-widest uppercase hover:bg-bh-black transition-colors">去逛逛</a>
  </div>

  <div v-else class="space-y-4">
    <a
      v-for="order in orders"
      :key="order.id"
      :href="'/orders/' + order.id"
      class="flex items-center justify-between gap-6 border-2 border-bh-black px-6 py-5 hover:border-bh-red transition-colors"
    >
      <div>
        <p class="font-numeral font-bold text-sm">{{ order.order_no }}</p>
        <p class="text-text-secondary text-xs mt-1">{{ new Date(order.created_at).toLocaleDateString('zh-TW') }}</p>
      </div>
      <div class="flex items-center gap-6">
        <span class="font-numeral font-black text-lg">NT$ {{ order.total_amount.toLocaleString() }}</span>
        <span class="inline-flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full" :class="statusMap[order.status]?.dot || 'bg-bh-black'"></span>
          <span class="text-xs font-bold tracking-widest uppercase">{{ statusMap[order.status]?.label || order.status }}</span>
        </span>
      </div>
    </a>
  </div>
</div>
