<div id="app" class="bg-bh-white text-bh-black">
  <!-- Hero Banner -->
  <section class="relative overflow-hidden bg-bh-white -mx-4 px-4 mb-12 h-[440px] md:h-[600px]">
    <div class="absolute -left-20 top-4 w-64 h-64 md:w-[480px] md:h-[480px] rounded-full bg-bh-red"></div>

    <div class="absolute right-[28%] top-[55%] w-40 h-36 md:w-[360px] md:h-[320px] bg-bh-blue rotate-[-35deg] [clip-path:polygon(0%_0%,100%_0%,50%_100%)]"></div>

    <div class="hidden md:block absolute right-16 top-8 w-44 h-44 bg-bh-yellow"></div>

    <span class="absolute left-8 top-6 font-display text-xs font-bold tracking-widest uppercase text-bh-black">FLOWER LIFE / 2026</span>

    <div class="relative z-10 h-full flex flex-col lg:flex-row justify-center lg:justify-start items-end gap-8 px-8 lg:pb-16">
      <div class="w-full lg:w-1/2">
        <div class="w-3/4 ml-auto">
          <h1 class="text-4xl sm:text-5xl md:text-6xl xl:text-7xl font-black text-bh-black leading-[0.95] font-display mb-6">
            讓花裝點<br>生活每一刻
          </h1>
          <div class="text-right md:text-left">
            <a href="#products" class="inline-block bg-bh-yellow text-bh-black px-7 py-3 font-bold text-xs tracking-widest uppercase hover:bg-bh-black hover:text-bh-white transition-colors">
              立即選購
            </a>
          </div>
        </div>
      </div>
      <div class="hidden lg:block w-1/2 h-full relative">
        <img
          src="https://images.unsplash.com/photo-1487530811176-3780de880c2d?w=600"
          alt="花束"
          class="absolute bottom-0 left-0 w-4/5 h-4/5 object-cover rounded-2xl border-2 border-bh-black"
        />
      </div>
    </div>
  </section>

  <!-- Featured Products -->
  <section class="mb-12">
    <span class="block font-display text-xs font-bold tracking-widest uppercase text-bh-red mb-2">FEATURED</span>
    <h2 class="text-3xl font-black text-bh-black font-display leading-[0.95] mb-1">精選推薦</h2>
    <p class="text-bh-black text-sm mb-6">本季最受歡迎的花卉精選</p>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
      <div
        v-for="(product, idx) in products.slice(0, 4)"
        :key="product.id"
        class="overflow-hidden cursor-pointer p-5"
        :class="[tileStyle(idx).bg, idx === 3 ? 'md:hidden lg:block' : '']"
        @click="goToProduct(product.id)"
      >
        <div class="aspect-square overflow-hidden mb-3">
          <img
            :src="product.image_url || featuredImages[idx % 4]"
            :alt="product.name"
            class="w-full h-full object-cover"
          />
        </div>
        <h3 class="font-bold text-sm truncate mb-1" :class="tileStyle(idx).text">{{ product.name }}</h3>
        <p class="font-numeral font-black text-lg flex items-center gap-1.5" :class="tileStyle(idx).text">
          <span class="w-2 h-2 rounded-full" :class="tileStyle(idx).bud"></span>
          NT$ {{ product.price.toLocaleString() }}
        </p>
      </div>
    </div>
  </section>

  <!-- Brand Story -->
  <section class="mb-12 overflow-hidden">
    <div class="flex flex-col md:flex-row">
      <div class="md:w-1/2">
        <img
          src="https://images.unsplash.com/photo-1508610048659-a06b669e3321?w=600"
          alt="花藝師"
          class="w-full h-64 md:h-full object-cover"
        />
      </div>
      <div class="md:w-1/2 p-8 md:p-12 flex flex-col justify-center bg-bh-black">
        <h2 class="text-3xl font-black text-bh-white font-display leading-[0.95] mb-4">
          專心，做好一束花的感動
        </h2>
        <p class="text-bh-white/80 leading-relaxed mb-6">
          花漾生活成立於 2020 年，我們相信每一朵花都有自己的故事。透過專業花藝師的巧手，將大自然的美好帶進您的日常生活中。
        </p>
        <div class="flex items-center gap-3">
          <%- include('../partials/stem-bud') %>
          <p class="text-bh-white italic text-sm">「每一束花，都是一份用心的禮物。」</p>
        </div>
      </div>
    </div>
  </section>

  <!-- All Products Grid -->
  <section id="products" class="mb-12">
    <h2 class="text-3xl font-black text-bh-black font-display leading-[0.95] mb-1">探索所有花藝</h2>
    <p class="text-bh-black text-sm mb-8">找到屬於您的那束花</p>

    <div v-if="loading" class="flex justify-center py-12">
      <div class="w-8 h-8 border-4 border-bh-red border-t-transparent rounded-full animate-spin"></div>
    </div>

    <template v-else>
      <div v-if="products.length === 0" class="text-center py-12">
        <div class="w-12 h-12 mx-auto mb-3 rounded-full border-2 border-bh-black"></div>
        <p class="text-bh-black">目前沒有商品</p>
        <p class="text-bh-black/60 text-sm">請稍後再來看看</p>
      </div>

      <div v-else class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <div
          v-for="(product, idx) in products"
          :key="product.id"
          @click="goToProduct(product.id)"
          class="overflow-hidden cursor-pointer p-5"
          :class="tileStyle(idx).bg"
        >
          <div class="aspect-square overflow-hidden mb-3">
            <img
              :src="product.image_url || 'https://images.unsplash.com/photo-1490750967868-88aa4f44baee?w=400'"
              :alt="product.name"
              class="w-full h-full object-cover"
            />
          </div>
          <h3 class="font-bold mb-1 truncate" :class="tileStyle(idx).text">{{ product.name }}</h3>
          <p class="font-numeral font-black text-lg mb-3 flex items-center gap-1.5" :class="tileStyle(idx).text">
            <span class="w-2 h-2 rounded-full" :class="tileStyle(idx).bud"></span>
            NT$ {{ product.price.toLocaleString() }}
          </p>
          <button
            @click.stop="addToCart(product)"
            :disabled="product._adding || product.stock <= 0"
            class="w-full py-2 text-xs font-bold tracking-widest uppercase transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
            :class="tileStyle(idx).button"
          >
            {{ product.stock <= 0 ? '已售完' : '加入購物車' }}
          </button>
        </div>
      </div>

      <!-- Pagination -->
      <div v-if="pagination.totalPages > 1" class="flex justify-center gap-2 mt-8">
        <button
          v-for="p in pagination.totalPages"
          :key="p"
          @click="loadProducts(p)"
          class="w-10 h-10 text-sm font-bold transition-colors"
          :class="p === pagination.page ? 'bg-bh-black text-bh-white' : 'bg-bh-white text-bh-black border-2 border-bh-black hover:bg-bh-yellow'"
        >
          {{ p }}
        </button>
      </div>
    </template>
  </section>

  <!-- Customer Testimonials -->
  <section class="mb-12">
    <h2 class="text-3xl font-black text-bh-black font-display leading-[0.95] mb-8">顧客花束好評分享</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="border-2 border-bh-black p-6">
        <div class="flex gap-1 mb-3">
          <span class="w-2 h-2 rounded-full bg-bh-red" v-for="n in 5" :key="n"></span>
        </div>
        <p class="text-bh-black text-sm mb-4">「花束非常漂亮，包裝精緻，送給媽媽她超開心的！配送也很準時。」</p>
        <p class="text-bh-black text-xs font-bold tracking-widest uppercase">小美</p>
      </div>
      <div class="border-2 border-bh-black p-6">
        <div class="flex gap-1 mb-3">
          <span class="w-2 h-2 rounded-full bg-bh-red" v-for="n in 5" :key="n"></span>
        </div>
        <p class="text-bh-black text-sm mb-4">「第二次購買了，品質一如既往的好。花材新鮮，整體搭配很有美感。」</p>
        <p class="text-bh-black text-xs font-bold tracking-widest uppercase">阿明</p>
      </div>
      <div class="border-2 border-bh-black p-6">
        <div class="flex gap-1 mb-3">
          <span class="w-2 h-2 rounded-full bg-bh-red" v-for="n in 5" :key="n"></span>
        </div>
        <p class="text-bh-black text-sm mb-4">「女朋友收到花束超感動！會再回購的，推薦給大家！」</p>
        <p class="text-bh-black text-xs font-bold tracking-widest uppercase">大衛</p>
      </div>
    </div>
  </section>

  <!-- Service Features -->
  <section class="mb-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-center py-4">
      <div>
        <svg class="w-12 h-12 mx-auto mb-3 text-bh-blue" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M1 3h15v13H1z"/>
          <path d="M16 8h4l3 3v5h-7V8z"/>
          <circle cx="5.5" cy="18.5" r="2.5"/>
          <circle cx="18.5" cy="18.5" r="2.5"/>
        </svg>
        <h3 class="font-bold text-bh-black mb-1">快速配送</h3>
        <p class="text-bh-black/60 text-sm">台北市區當日配送</p>
      </div>
      <div>
        <svg class="w-12 h-12 mx-auto mb-3 text-bh-yellow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="9" width="18" height="11"/>
          <line x1="3" y1="13" x2="21" y2="13"/>
          <line x1="12" y1="9" x2="12" y2="20"/>
          <path d="M12 9c-1.5-3-6-3-6 0s4.5 0 6 0z"/>
          <path d="M12 9c1.5-3 6-3 6 0s-4.5 0-6 0z"/>
        </svg>
        <h3 class="font-bold text-bh-black mb-1">精美包裝</h3>
        <p class="text-bh-black/60 text-sm">每束花都經過精心包裝</p>
      </div>
      <div>
        <svg class="w-12 h-12 mx-auto mb-3 text-bh-red" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 21s-8-4.5-8-11a4.5 4.5 0 0 1 8-2.8A4.5 4.5 0 0 1 20 10c0 6.5-8 11-8 11z"/>
        </svg>
        <h3 class="font-bold text-bh-black mb-1">滿額免運</h3>
        <p class="text-bh-black/60 text-sm">消費滿 NT$ 500 免運費</p>
      </div>
    </div>
  </section>
</div>
