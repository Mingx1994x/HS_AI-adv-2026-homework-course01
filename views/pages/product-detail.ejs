<div id="app" data-product-id="<%= productId %>" class="bg-bh-white text-bh-black">
  <div v-if="loading" class="flex justify-center py-12">
    <div class="w-8 h-8 border-4 border-bh-red border-t-transparent rounded-full animate-spin"></div>
  </div>

  <div v-else-if="notFound" class="text-center py-16">
    <div class="w-16 h-16 mx-auto mb-4 rounded-full border-2 border-bh-black"></div>
    <h2 class="text-xl font-bold text-bh-black mb-2">找不到此商品</h2>
    <a href="/" class="text-bh-red hover:text-bh-black text-sm font-bold">回到首頁</a>
  </div>

  <div v-else-if="product" class="flex flex-col md:flex-row gap-8 md:gap-12">
    <!-- Left: Image -->
    <div class="w-full md:w-3/5">
      <div class="relative overflow-hidden rounded-tl-2xl rounded-br-2xl">
        <img
          :src="product.image_url || 'https://images.unsplash.com/photo-1490750967868-88aa4f44baee?w=600'"
          :alt="product.name"
          class="w-full aspect-square object-cover rounded-tl-2xl rounded-br-2xl"
        />
        <div class="hidden md:block absolute bottom-0 right-0 w-28 h-28 bg-bh-yellow rotate-180 [clip-path:polygon(0%_0%,100%_0%,50%_100%)]"></div>
      </div>
    </div>

    <!-- Right: Info -->
    <div class="w-full md:w-2/5 pt-6">
      <h1 class="text-3xl md:text-4xl font-black text-bh-black leading-[0.95] font-display mb-3">
        {{ product.name }}
      </h1>
      <p class="font-numeral font-black text-4xl text-bh-black flex items-center gap-2 mb-4">
        <span class="w-3 h-3 rounded-full bg-bh-red"></span>
        NT$ {{ product.price.toLocaleString() }}
      </p>

      <div class="mb-6">
        <span class="inline-flex items-center gap-2">
          <span class="w-3 h-3 rounded-full" :class="product.stock > 0 ? 'bg-bh-blue' : 'bg-bh-red'"></span>
          <span class="text-xs font-bold tracking-widest uppercase">{{ product.stock > 0 ? '尚有 ' + product.stock + ' 件' : '已售完' }}</span>
        </span>
      </div>

      <p class="text-bh-black/70 leading-relaxed mb-6">{{ product.description }}</p>

      <!-- Quantity Selector -->
      <div class="flex items-center gap-4 mb-6">
        <span class="text-xs font-bold tracking-widest uppercase text-bh-black">數量</span>
        <div class="flex items-center border-2 border-bh-black">
          <button
            @click="decrease"
            class="w-12 h-12 flex items-center justify-center hover:bg-bh-black hover:text-bh-white text-bh-black font-numeral font-bold text-xl transition-colors"
          >
            −
          </button>
          <span class="w-14 h-12 flex items-center justify-center text-sm font-numeral font-bold border-x-2 border-bh-black">
            {{ quantity }}
          </span>
          <button
            @click="increase"
            class="w-12 h-12 flex items-center justify-center hover:bg-bh-black hover:text-bh-white text-bh-black font-numeral font-bold text-xl transition-colors"
          >
            +
          </button>
        </div>
      </div>

      <button
        @click="addToCart"
        :disabled="adding || product.stock <= 0"
        class="w-full bg-bh-red text-bh-white py-4 text-xs font-bold tracking-widest uppercase hover:bg-bh-black transition-colors disabled:opacity-50"
      >
        {{ product.stock <= 0 ? '已售完' : '加入購物車' }}
      </button>

      <!-- Purchase Notes -->
      <div class="mt-8 border-2 border-bh-black p-5">
        <h3 class="font-bold text-bh-black mb-2 text-xs tracking-widest uppercase">購買須知</h3>
        <ul class="text-bh-black/70 text-xs space-y-1.5">
          <li>- 花材依據季節供應，實際花束可能略有差異</li>
          <li>- 台北市區可享當日配送服務</li>
          <li>- 消費滿 NT$ 500 享免運優惠</li>
        </ul>
      </div>
    </div>
  </div>
</div>
