<div id="app" data-order-id="<%= orderId %>" data-payment-result="<%= paymentResult %>" class="bg-bh-white text-bh-black">
  <h1 class="text-3xl font-black font-display leading-[0.95] mb-6">訂單詳情</h1>

  <div v-if="loading" class="flex justify-center py-12">
    <div class="w-8 h-8 border-4 border-bh-red border-t-transparent rounded-full animate-spin"></div>
  </div>

  <template v-else-if="order">
    <!-- Status Bar -->
    <div class="bg-bh-black text-bh-white flex flex-wrap items-center justify-between gap-3 px-6 py-5 mb-1">
      <span class="font-numeral font-bold text-sm">{{ order.order_no }} ・ {{ new Date(order.created_at).toLocaleDateString('zh-TW') }}</span>
      <span class="inline-flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full" :class="statusMap[order.status]?.dot || 'bg-bh-white'"></span>
        <span class="text-xs font-bold tracking-widest uppercase">{{ statusMap[order.status]?.label || order.status }}</span>
      </span>
    </div>

    <!-- Payment Result Banner -->
    <div
      v-if="paymentResult && paymentMessages[paymentResult]"
      class="px-6 py-3 mb-6 text-xs font-bold tracking-widest uppercase text-center text-bh-white"
      :class="paymentMessages[paymentResult].bg"
    >
      {{ paymentMessages[paymentResult].text }}
    </div>
    <div v-else class="mb-6"></div>

    <!-- Recipient Info -->
    <div class="mb-8">
      <h2 class="font-bold font-display text-lg mb-3">收件資訊</h2>
      <div class="text-sm space-y-1.5">
        <p>收件人：{{ order.recipient_name }}</p>
        <p>Email：{{ order.recipient_email }}</p>
        <p>地址：{{ order.recipient_address }}</p>
      </div>
    </div>

    <!-- Order Items -->
    <div class="mb-8">
      <div class="flex items-center gap-4 border-b border-bh-black pb-3">
        <span class="flex-1 text-xs font-bold tracking-widest uppercase">商品名稱</span>
        <span class="w-28 text-right text-xs font-bold tracking-widest uppercase">單價</span>
        <span class="w-20 text-right text-xs font-bold tracking-widest uppercase">數量</span>
        <span class="w-28 text-right text-xs font-bold tracking-widest uppercase">小計</span>
      </div>
      <div v-for="item in order.items" :key="item.id" class="flex items-center gap-4 border-b border-bh-black py-3.5">
        <span class="flex-1 text-sm">{{ item.product_name }}</span>
        <span class="w-28 text-right font-numeral font-bold text-sm">NT$ {{ item.product_price.toLocaleString() }}</span>
        <span class="w-20 text-right font-numeral font-bold text-sm">{{ item.quantity }}</span>
        <span class="w-28 text-right font-numeral font-bold text-sm">NT$ {{ (item.product_price * item.quantity).toLocaleString() }}</span>
      </div>
      <div class="flex items-center justify-end gap-6 border-t-4 border-bh-black pt-5">
        <span class="font-bold font-display text-lg">總計</span>
        <span class="font-numeral font-black text-3xl text-bh-red">NT$ {{ order.total_amount.toLocaleString() }}</span>
      </div>
    </div>

    <!-- Payment Button -->
    <div v-if="order.status === 'pending'" class="flex gap-4">
      <a
        :href="`/payment/ecpay/start/${order.id}`"
        class="bg-bh-blue text-bh-white px-8 py-3 text-xs font-bold tracking-widest uppercase hover:bg-bh-black transition-colors"
      >
        前往付款（綠界）
      </a>
    </div>
  </template>
</div>
